@{
    ViewData["Title"] = "Đăng nhập hai yếu tố";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="m-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <p>Tính năng đăng nhập hai yếu tố chưa được thiết lập trong hệ thống này.</p>
                        <p>Vui lòng liên hệ quản trị viên để biết thêm chi tiết.</p>
                    </div>
                    <div class="form-group mt-4">
                        <a asp-action="Login" class="btn btn-outline-primary">Quay lại trang đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 