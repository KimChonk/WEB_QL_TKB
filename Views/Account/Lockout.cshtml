@{
    ViewData["Title"] = "Tài khoản đã bị khóa";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="m-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <p>Tài khoản của bạn đã tạm thời bị khóa do có quá nhiều lần đăng nhập không thành công.</p>
                        <p>Vui lòng thử lại sau 5 phút.</p>
                    </div>
                    <div class="form-group mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Quay lại trang chủ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 