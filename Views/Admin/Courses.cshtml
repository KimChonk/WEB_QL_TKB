@model IEnumerable<TimetableManagementApp.Models.Course>

@{
    ViewData["Title"] = "Quản lý khóa học";
}

<div class="container">
    <h1 class="my-4">@ViewData["Title"]</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách khóa học</h6>
            <div>
                <a asp-controller="TimetableImport" asp-action="Import" class="btn btn-success">
                    <i class="bi bi-file-earmark-excel"></i> Nhập từ Excel
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="courseTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã khóa học</th>
                            <th>Tên khóa học</th>
                            <th>Tín chỉ</th>
                            <th>Khoa/Bộ môn</th>
                            <th>Sinh viên</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>@course.CourseCode</td>
                                <td>@course.CourseName</td>
                                <td>@course.Credits</td>
                                <td>@course.Department</td>
                                <td>
                                    @course.CourseEnrollments?.Count ?? 0
                                </td>
                                <td>
                                    <a asp-action="CourseDetails" asp-route-id="@course.CourseCode" class="btn btn-info btn-sm">
                                        <i class="bi bi-info-circle"></i>
                                    </a>
                                    <a asp-action="EditCourse" asp-route-id="@course.CourseCode" class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#courseTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json'
                }
            });
        });
    </script>
} 