@model TimetableManagementApp.Models.Room

@{
    ViewData["Title"] = "Chi tiết phòng học";
}

<div class="container">
    <h1 class="my-4">@ViewData["Title"]</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Thông tin phòng học</h6>
            <div>
                <a asp-action="EditRoom" asp-route-id="@Model.RoomID" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Chỉnh sửa
                </a>
                <a asp-action="Rooms" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            Thông tin cơ bản
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Mã phòng:</dt>
                                <dd class="col-sm-8">@Model.RoomID</dd>

                                <dt class="col-sm-4">Tên phòng:</dt>
                                <dd class="col-sm-8">@Model.RoomName</dd>

                                <dt class="col-sm-4">Sức chứa:</dt>
                                <dd class="col-sm-8">@(Model.Capacity.HasValue ? Model.Capacity.Value.ToString() : "Chưa cập nhật")</dd>

                                <dt class="col-sm-4">Vị trí:</dt>
                                <dd class="col-sm-8">@Model.Location</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            Thống kê
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-6">Tổng số lịch học:</dt>
                                <dd class="col-sm-6">@ViewBag.TimetableCount lịch</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            @if (ViewBag.Timetables != null && ViewBag.Timetables.Count > 0)
            {
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Lịch giảng dạy (@ViewBag.Timetables.Count)</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="timetableTable" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Thứ</th>
                                        <th>Tiết</th>
                                        <th>Môn học</th>
                                        <th>Giảng viên</th>
                                        <th>Loại</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var timetable in ViewBag.Timetables)
                                    {
                                        <tr>
                                            <td>Thứ @timetable.DayOfWeek</td>
                                            <td>@timetable.StartPeriod - @(timetable.StartPeriod + timetable.NumPeriods - 1)</td>
                                            <td>@timetable.Course?.CourseName (@timetable.CourseCode)</td>
                                            <td>@timetable.Lecturer?.FullName</td>
                                            <td>@timetable.Type</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#timetableTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json'
                },
                pageLength: 10
            });
        });
    </script>
} 