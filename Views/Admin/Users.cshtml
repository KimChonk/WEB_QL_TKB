@model IEnumerable<TimetableManagementApp.Models.ApplicationUser>
@using System.Text.Json;
@{
    ViewData["Title"] = "Quản lý tài khoản";
    Dictionary<string, string> importedUsers = null;
    if (TempData["ImportedUsers"] != null)
    {
        try
        {
            importedUsers = JsonSerializer.Deserialize<Dictionary<string, string>>(TempData["ImportedUsers"].ToString());
        }
        catch { /* Xử lý lỗi nếu cần */ }
    }
}

<div class="container">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["DefaultPassword"] != null)
    {
        <div class="alert alert-info">
            <h5>Mật khẩu mặc định cho tài khoản vừa tạo:</h5>
            <p class="mb-0"><strong>@TempData["DefaultPassword"]</strong></p>
            <p class="mt-2 mb-0">Hãy ghi nhớ mật khẩu này và thông báo cho người dùng, họ sẽ cần nó để đăng nhập lần đầu.</p>
        </div>
    }
    
    @if (importedUsers != null && importedUsers.Count > 0)
    {
        <div class="alert alert-info">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Danh sách tài khoản vừa tạo:</h5>
                <button class="btn btn-sm btn-secondary" onclick="toggleImportedAccounts()">Hiển thị/Ẩn</button>
            </div>
            <div id="importedAccountsList" class="mt-3" style="display: none;">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Mật khẩu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in importedUsers)
                            {
                                <tr>
                                    <td>@user.Key</td>
                                    <td>@user.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-2">
                    <p class="text-danger mb-0"><strong>Chú ý:</strong> Thông tin này chỉ hiển thị một lần! Hãy lưu lại để thông báo cho người dùng.</p>
                </div>
            </div>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Index" class="btn btn-secondary mr-2">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <a asp-action="ImportUsers" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Nhập từ Excel
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <span>Danh sách tài khoản</span>
                <div>
                    <span id="passwordNote" class="badge bg-info text-dark" style="cursor: pointer;" 
                          onclick="togglePasswordInfo()">Thông tin mật khẩu</span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div id="passwordInfo" class="alert alert-info mb-3" style="display: none;">
                <h5>Lưu ý về mật khẩu:</h5>
                <ul class="mb-0">
                    <li>Tài khoản nhập từ Excel sẽ có mật khẩu theo cột thứ 3 trong file Excel</li>
                    <li>Nếu không có mật khẩu trong Excel, mật khẩu mặc định sẽ được sử dụng</li>
                    <li>Nếu mật khẩu không đủ mạnh, hệ thống sẽ tự động tạo mật khẩu mạnh</li>
                    <li>Bạn có thể đặt lại mật khẩu bằng cách nhấn vào nút "Đổi mật khẩu"</li>
                </ul>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Họ tên</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>@user.FullName</td>
                                <td>@user.Role</td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">Đã kích hoạt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Chưa kích hoạt</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-info-circle"></i> Chi tiết
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-key"></i> Đổi mật khẩu
                                    </a>
                                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordInfo() {
            var info = document.getElementById('passwordInfo');
            if (info.style.display === 'none') {
                info.style.display = 'block';
            } else {
                info.style.display = 'none';
            }
        }
        
        function toggleImportedAccounts() {
            var accounts = document.getElementById('importedAccountsList');
            if (accounts.style.display === 'none') {
                accounts.style.display = 'block';
            } else {
                accounts.style.display = 'none';
            }
        }
    </script>
} 