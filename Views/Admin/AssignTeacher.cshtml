@{
    ViewData["Title"] = "Phân công giảng viên";
    var course = ViewBag.Course as TimetableManagementApp.Models.Course;
}

<div class="container">
    <h2 class="my-4">@ViewData["Title"]</h2>
    
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Phân công giảng viên cho khóa học: @course.CourseName (@course.CourseCode)</h6>
        </div>
        <div class="card-body">
            <form asp-action="AssignTeacher" method="post">
                <input type="hidden" name="courseCode" value="@course.CourseCode" />
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["ErrorMessage"]
                    </div>
                }
                
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="teacherId" class="form-label">Giảng viên</label>
                            <select class="form-select" name="teacherId" id="teacherId" required>
                                <option value="">-- Chọn giảng viên --</option>
                                @foreach (var teacher in ViewBag.Teachers)
                                {
                                    if (teacher.Selected)
                                    {
                                        <option value="@teacher.Value" selected>@teacher.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@teacher.Value">@teacher.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="startDate" class="form-label">Ngày bắt đầu</label>
                            <input type="date" class="form-control" id="startDate" name="startDate" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="endDate" class="form-label">Ngày kết thúc</label>
                            <input type="date" class="form-control" id="endDate" name="endDate" required />
                        </div>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="dayOfWeek" class="form-label">Thứ trong tuần</label>
                            <select class="form-select" id="dayOfWeek" name="dayOfWeek" required>
                                <option value="">-- Chọn thứ --</option>
                                <option value="2">Thứ 2</option>
                                <option value="3">Thứ 3</option>
                                <option value="4">Thứ 4</option>
                                <option value="5">Thứ 5</option>
                                <option value="6">Thứ 6</option>
                                <option value="7">Thứ 7</option>
                                <option value="1">Chủ nhật</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="startPeriod" class="form-label">Tiết bắt đầu</label>
                            <select class="form-select" id="startPeriod" name="startPeriod" required>
                                <option value="">-- Chọn tiết --</option>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <option value="@i">Tiết @i</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="numPeriods" class="form-label">Số tiết</label>
                            <select class="form-select" id="numPeriods" name="numPeriods" required>
                                <option value="">-- Chọn số tiết --</option>
                                @for (int i = 1; i <= 6; i++)
                                {
                                    <option value="@i">@i tiết</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="roomId" class="form-label">Phòng học</label>
                            <input type="text" class="form-control" id="roomId" name="roomId" placeholder="Nhập mã phòng học" required />
                            <small class="form-text text-muted">Nhập mã phòng học (ví dụ: A101, B202, ...)</small>
                        </div>
                    </div>
                </div>
                
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="CourseDetails" asp-route-id="@course.CourseCode" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Lưu phân công
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Set default dates
            var today = new Date();
            var startDate = new Date();
            var endDate = new Date();
            
            // Set default start date to next Monday
            var dayToAdd = (8 - today.getDay()) % 7;
            if (dayToAdd === 0) dayToAdd = 7; // If today is Monday, add 7 days
            startDate.setDate(today.getDate() + dayToAdd);
            
            // Set default end date to 16 weeks after start date
            endDate.setDate(startDate.getDate() + 112); // 16 weeks * 7 days
            
            // Format dates as YYYY-MM-DD
            function formatDate(date) {
                var year = date.getFullYear();
                var month = (date.getMonth() + 1).toString().padStart(2, '0');
                var day = date.getDate().toString().padStart(2, '0');
                return `${year}-${month}-${day}`;
            }
            
            $('#startDate').val(formatDate(startDate));
            $('#endDate').val(formatDate(endDate));
        });
    </script>
} 