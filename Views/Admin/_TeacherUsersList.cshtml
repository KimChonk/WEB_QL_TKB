@model IEnumerable<TimetableManagementApp.Models.ApplicationUser>

<div class="table-responsive">
    <table class="table table-bordered" id="teachersTable" width="100%" cellspacing="0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    <td>
                        <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-info btn-sm">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-key"></i>
                        </a>
                        <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-danger btn-sm" 
                           onclick="return confirm('Bạn có chắc chắn muốn xóa người dùng này?');">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function() {
        $('#teachersTable').DataTable({
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json'
            }
        });
    });
</script> 