@model TimetableManagementApp.Models.Lecturer

@{
    ViewData["Title"] = "Lecturer Details";
}

<h1>Lecturer Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Lecturer ID
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.LecturerId)
        </dd>
        <dt class="col-sm-3">
            Full Name
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Phone)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Department)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Department)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.LecturerId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div> 