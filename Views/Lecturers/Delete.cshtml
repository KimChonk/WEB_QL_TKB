@model TimetableManagementApp.Models.Lecturer

@{
    ViewData["Title"] = "Delete Lecturer";
}

<h1>Delete Lecturer</h1>

@if (ViewBag.HasRelatedRecords == true)
{
    <div class="alert alert-danger">
        <h4>Cannot Delete</h4>
        <p>This lecturer cannot be deleted because they are assigned to one or more timetable entries.</p>
        <p>You must remove this lecturer from all timetables before deleting.</p>
    </div>
}
else
{
    <div class="alert alert-danger">
        <h3>Are you sure you want to delete this lecturer?</h3>
    </div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Lecturer ID
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.LecturerId)
        </dd>
        <dt class="col-sm-3">
            Full Name
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Phone)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Department)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Department)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="LecturerId" />
        @if (ViewBag.HasRelatedRecords != true)
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
        }
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div> 