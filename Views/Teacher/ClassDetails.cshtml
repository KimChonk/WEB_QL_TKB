@model TimetableManagementApp.Models.Timetable

@{
    ViewData["Title"] = "Chi tiết lớp học";
}

<div class="container">
    <div class="mb-4">
        <a asp-action="MyClasses" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách lớp học
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Thông tin lớp học</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="fw-bold">Thông tin khóa học</h6>
                    <ul class="list-group mb-4">
                        <li class="list-group-item"><strong>Mã học phần:</strong> @Model.CourseCode</li>
                        <li class="list-group-item"><strong>Tên học phần:</strong> @(Model.Course?.CourseName ?? "Không xác định")</li>
                        <li class="list-group-item"><strong>Số tín chỉ:</strong> @(Model.Course?.Credits.ToString() ?? "Không xác định")</li>
                        <li class="list-group-item"><strong>Khoa/Bộ môn:</strong> @(Model.Course?.Department ?? "Không xác định")</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6 class="fw-bold">Thông tin lịch học</h6>
                    <ul class="list-group mb-4">
                        <li class="list-group-item"><strong>Ngày học:</strong> Thứ @Model.DayOfWeek</li>
                        <li class="list-group-item"><strong>Tiết học:</strong> @Model.StartPeriod - @(Model.StartPeriod + Model.NumPeriods - 1)</li>
                        <li class="list-group-item"><strong>Phòng học:</strong> @(Model.Room?.RoomName ?? "Không xác định")</li>
                        <li class="list-group-item"><strong>Giảng viên:</strong> @(Model.Lecturer?.FullName ?? "Không xác định")</li>
                        <li class="list-group-item"><strong>Thời gian bắt đầu:</strong> @(Model.DateStart?.ToString("dd/MM/yyyy") ?? "Không xác định")</li>
                        <li class="list-group-item"><strong>Thời gian kết thúc:</strong> @(Model.DateEnd?.ToString("dd/MM/yyyy") ?? "Không xác định")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Danh sách sinh viên</h5>
            <a asp-action="CourseStudents" asp-route-courseCode="@Model.CourseCode" class="btn btn-light btn-sm">
                <i class="bi bi-list-ul"></i> Xem tất cả sinh viên
            </a>
        </div>
        <div class="card-body">
            <p class="text-center">Nhấn nút "Xem tất cả sinh viên" để xem và quản lý danh sách sinh viên của lớp học.</p>
        </div>
    </div>
</div> 