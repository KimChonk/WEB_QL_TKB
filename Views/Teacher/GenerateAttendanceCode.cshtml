@model TimetableManagementApp.ViewModels.AttendanceViewModel
@{
    ViewData["Title"] = "Mã điểm danh";
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-xl-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin buổi học</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <tbody>
                                <tr>
                                    <th>Mã học phần:</th>
                                    <td>@Model.Timetable.CourseCode</td>
                                </tr>
                                <tr>
                                    <th>Tên học phần:</th>
                                    <td>@Model.Timetable.Course?.CourseName</td>
                                </tr>
                                <tr>
                                    <th>Phòng học:</th>
                                    <td>@Model.Timetable.Room?.RoomName</td>
                                </tr>
                                <tr>
                                    <th>Ngày học:</th>
                                    <td>@DateTime.Now.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <th>Tiết học:</th>
                                    <td>
                                        @if (Model.Timetable.StartPeriod.HasValue && Model.Timetable.NumPeriods.HasValue)
                                        {
                                            @(Model.Timetable.StartPeriod) <text>-</text> @(Model.Timetable.StartPeriod + Model.Timetable.NumPeriods - 1)
                                        }
                                        else
                                        {
                                            <text>Chưa cập nhật</text>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Số sinh viên đăng ký:</th>
                                    <td>@Model.EnrolledStudents.Count người</td>
                                </tr>
                                <tr>
                                    <th>Số sinh viên đã điểm danh:</th>
                                    <td>@Model.Attendances.Count(a => a.IsPresent) / @Model.Attendances.Count người</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-success">Mã điểm danh</h6>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <div class="alert alert-info mb-3">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            Mã điểm danh có hiệu lực trong 15 phút kể từ @Model.CodeGeneratedTime.ToString("HH:mm:ss")
                        </div>
                        
                        <div class="code-display p-4 mb-3 border border-primary rounded">
                            <h1 class="display-4 fw-bold text-primary mb-0">@Model.AttendanceCode</h1>
                        </div>
                        
                        <p>Hoặc quét mã QR sau:</p>
                        
                        <div class="mb-3">
                            <a href="@Model.QRCodeUrl" class="btn btn-primary mb-3">
                                <i class="bi bi-qr-code"></i> Hiển thị mã QR
                            </a>
                        </div>
                        
                        <p class="mb-0">Sinh viên sẽ dùng mã này để điểm danh.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Danh sách sinh viên</h6>
                    <div>
                        <a href="@Url.Action("ManageAttendance", new { timetableId = Model.Timetable.TimetableID })" class="btn btn-primary btn-sm">
                            <i class="bi bi-list-check"></i> Quản lý điểm danh
                        </a>
                        <a href="@Url.Action("GenerateAttendanceCode", new { timetableId = Model.Timetable.TimetableID })" class="btn btn-success btn-sm">
                            <i class="bi bi-arrow-repeat"></i> Tạo mã mới
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Mã SV</th>
                                    <th>Họ và tên</th>
                                    <th>Email</th>
                                    <th>Trạng thái</th>
                                    <th>Thời gian điểm danh</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                    foreach (var student in Model.EnrolledStudents)
                                    {
                                        var attendance = Model.Attendances.FirstOrDefault(a => a.StudentId == student.Id);
                                        <tr>
                                            <td>@index</td>
                                            <td>@student.Id.Substring(0, Math.Min(8, student.Id.Length))</td>
                                            <td>@student.FullName</td>
                                            <td>@student.Email</td>
                                            <td>
                                                @if (attendance != null && attendance.IsPresent)
                                                {
                                                    <span class="badge bg-success">Có mặt</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Vắng mặt</span>
                                                }
                                            </td>
                                            <td>
                                                @if (attendance != null && attendance.AttendanceTime.HasValue)
                                                {
                                                    @attendance.AttendanceTime.Value.ToString("HH:mm:ss dd/MM/yyyy")
                                                }
                                                else
                                                {
                                                    <text>-</text>
                                                }
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/vi.json'
                }
            });
            
            // Auto-refresh da ta
            setInterval(function() {
                window.location.reload();
            }, 60000); // Refresh every 60 seconds
        });
    </script>
} 