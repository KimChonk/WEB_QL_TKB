@model TimetableManagementApp.ViewModels.CourseStudentsViewModel

@{
    ViewData["Title"] = $"Danh sách sinh viên - {Model.Course.CourseName}";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách sinh viên khóa học: @Model.Course.CourseName (@Model.Course.CourseCode)</h6>
            <a asp-action="MyTimetable" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại thời khóa biểu
            </a>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="studentTable" width="100%" cellspacing="0">
                    <thead>
                        <tr class="bg-light">
                            <th>STT</th>
                            <th>Mã SV</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Ngày đăng ký</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Students.Any())
                        {
                            int index = 1;
                            foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@student.Id</td>
                                    <td>@student.FullName</td>
                                    <td>@student.Email</td>
                                    <td>@student.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">Không có sinh viên nào đăng ký khóa học này.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#studentTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/vi.json'
                },
                "pageLength": 10,
                "responsive": true
            });
        });
    </script>
} 