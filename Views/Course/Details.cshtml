@model TimetableManagementApp.ViewModels.CourseDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết khóa học";
}

<div class="container">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Thông tin khóa học</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="fw-bold">Mã khóa học:</label>
                        <p>@Model.Course.CourseCode</p>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Tên khóa học:</label>
                        <p>@Model.Course.CourseName</p>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Số tín chỉ:</label>
                        <p>@Model.Course.Credits</p>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Khoa/Bộ môn:</label>
                        <p>@(Model.Course.Department ?? "Chưa cập nhật")</p>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Số sinh viên đăng ký:</label>
                        <p>@Model.StudentCount</p>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Danh sách sinh viên</h5>
                    <a asp-action="AddStudent" asp-route-id="@Model.Course.CourseCode" class="btn btn-sm btn-success">
                        <i class="bi bi-plus"></i> Thêm sinh viên
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.EnrolledStudents.Count == 0)
                    {
                        <div class="alert alert-info">
                            Chưa có sinh viên nào đăng ký khóa học này.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Email</th>
                                        <th>Họ tên</th>
                                        <th>Ngày đăng ký</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.EnrolledStudents)
                                    {
                                        <tr>
                                            <td>@student.Email</td>
                                            <td>@student.FullName</td>
                                            <td>@student.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <form asp-action="RemoveStudent" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên này khỏi khóa học?');">
                                                    <input type="hidden" name="studentId" value="@student.Id">
                                                    <input type="hidden" name="courseCode" value="@Model.Course.CourseCode">
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Thời khóa biểu</h5>
                </div>
                <div class="card-body">
                    @if (Model.Timetables.Count == 0)
                    {
                        <div class="alert alert-info">
                            Chưa có thời khóa biểu nào cho khóa học này.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Thứ</th>
                                        <th>Tiết</th>
                                        <th>Phòng</th>
                                        <th>Giảng viên</th>
                                        <th>Ngày bắt đầu</th>
                                        <th>Ngày kết thúc</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var timetable in Model.Timetables)
                                    {
                                        <tr>
                                            <td>Thứ @(timetable.DayOfWeek + 1)</td>
                                            <td>@timetable.StartPeriod - @(timetable.StartPeriod + timetable.NumPeriods - 1)</td>
                                            <td>@(timetable.Room?.RoomName ?? "Chưa cập nhật")</td>
                                            <td>@(timetable.Lecturer?.FullName ?? "Chưa cập nhật")</td>
                                            <td>@(timetable.DateStart?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</td>
                                            <td>@(timetable.DateEnd?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 